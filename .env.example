# ---------------------------------------------------------------------------
# RoomyAI Project — environment variables
# Copy to `.env.local` and fill in. NEVER commit a filled-in copy.
# Every value below is empty on purpose. Nothing secret lives in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# --- Google Gemini (chat + room analysis + image editing, one key) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat model. Must support tool use.
LLM_MODEL=gemini-3.8-flash

# Room photo analysis. Defaults to LLM_MODEL — set it only if you want the
# vision work on a different model than the chat.
VISION_MODEL=

# Image editing model for the ImageEditProvider adapter (build step 5).
IMAGE_MODEL=gemini-3.1-flash-image

# --- Supabase (Postgres + Storage). Only needed when DB_ADAPTER=supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=        # browser-safe key, used from client code in a later step
SUPABASE_SERVICE_ROLE_KEY=

# --- Local-stub settings (used when you have no Supabase project yet) ---
# "local"    = JSON files under .data/  (default, zero credentials needed)
# "supabase" = the real Supabase project
DB_ADAPTER=local

# --- Accounts (optional — the chat works as a guest without them) ---
# Which system holds the accounts:
#   "supabase" = Supabase Auth (needs SUPABASE_URL + SUPABASE_ANON_KEY)
#   "local"    = our own email + password table, hashed with scrypt
# Leave it empty and it follows DB_ADAPTER: supabase → Supabase Auth,
# local → our own accounts. When Supabase Auth is not switched on, the app
# falls back to our own accounts rather than refusing to start.
# The tables the accounts need arrive with supabase/migrations/0003_auth.sql.
AUTH_MODE=

# Where room photos are written. Defaults to "supabase" when the Supabase
# credentials above are present, and "local" otherwise (.data/uploads/).
# Set it explicitly to keep photos local while the database is still Supabase.
PHOTO_STORE=

# Images *generated* per session before the quota message appears. Uploading
# your own room photo does not spend this.
IMAGE_QUOTA_PER_SESSION=10

# How many room photos one session may upload. Stops a single session from
# filling the bucket; unrelated to the generation quota above.
ROOM_PHOTOS_PER_SESSION=4

# Signed URL lifetime for private photo access.
SIGNED_URL_TTL_SECONDS=3600

# Upload guard rails from the spec.
MAX_UPLOAD_MB=8
UPLOAD_LONG_EDGE_PX=1536

# Chat rate limit, per session and per IP.
CHAT_TURNS_PER_HOUR=20

# How long one image generation may run before it is abandoned.
GENERATION_TIMEOUT_MS=90000

# How many stored messages to resend to the model each turn. Higher = the model
# remembers more of the conversation, but every turn costs more and takes longer.
MAX_HISTORY_MESSAGES=16

# --- Retention (build step 7) ---
# The secret that authorises /api/cleanup. Leave it EMPTY and the endpoint
# is off: with no secret there is nothing to compare the token against, and an
# open "delete everything older than N days" endpoint should not be reachable.
# The npm script (`npm run cleanup`) does not need it — it runs on the machine
# that holds the credentials.
CLEANUP_SECRET=

# The same secret under the name Vercel looks for. Vercel sends the value of
# CRON_SECRET back as `Authorization: Bearer ...` when its own cron calls
# /api/cleanup, so on Vercel this is the one to set — either name switches
# the sweep on. 16 random characters or more.
CRON_SECRET=

# How long a session and its photos are kept before the sweep removes them.
RETENTION_DAYS=7